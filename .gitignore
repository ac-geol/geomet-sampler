# ---------------------------------------------------------------- python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.DS_Store

# ---------------------------------------------------------------- outputs
# Pick lists, composites and gap registers are derived from whatever data was
# loaded. On a real project they carry real hole IDs, grades and coordinates.
output/
*.xlsx
*.xls

# ------------------------------------------------- real drillhole data (deny by default)
# This repository is public. `data/` is ignored unconditionally: there are no
# exceptions and nothing in it is ever tracked, so no judgement call stands
# between a real export and a commit. The example dataset is not stored here --
# regenerate it with `uv run python scripts/make_example_data.py`.
data/

# A real project config carries the project name, CRS, network drive paths and
# the column names of a client's database. Only the example config is public.
config/*
!config/example_project.yaml

# Common drillhole database and mine planning package exports, wherever they land.
*.mdb
*.accdb
*.sqlite
*.sqlite3
*.db
*.dm
*.dmbm
*.bmf
*.dgd
*.00t
*.str
*.mdl
*.lfpkg
*.zip
*.7z

